-- StickyBoard - Example Hyprland Configuration
-- Append this to ~/.config/hypr/autostart.lua (or ~/.config/hypr/hyprland.lua)

-- Note Windows Rules (com.stickyboard.note*)
-- Direct all notes to workspace 6, make them float and disable animation
o.window("com\\.stickyboard\\.note.*", {
  workspace = "6",
  float = true,
  no_anim = true,
})

-- Capture Popup Window Rules
-- Float the capture window, center it, and force focus for instant typing
o.window("com\\.stickyboard\\.capture", {
  float = true,
  center = true,
  stay_focused = true,
  pin = true,
  dim_around = true,
})
