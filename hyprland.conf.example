# StickyBoard - Example Hyprland Configuration
# Append this to ~/.config/hypr/hyprland.conf

# Note Windows Rules (com.stickyboard.note*)
# Direct all notes to workspace 6, make them float and pin them across monitor transitions
windowrule {
    name = stickyboard-notes
    match:class = com\.stickyboard\.note.*
    workspace = 6
    float = on
    no_anim = on
}

# Capture Popup Window Rules
# Float the capture window, center it, and force focus for instant typing
windowrule {
    name = stickyboard-capture
    match:class = com\.stickyboard\.capture
    float = on
    center = on
    stay_focused = on
    pin = on
    dim_around = on
}
